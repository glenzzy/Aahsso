# Copy to .env and fill in
PORT=8080
DATABASE_URL=postgres://kargo:kargo@localhost:5432/kargo
JWT_SECRET=change-me-to-a-long-random-string
# (The free trial is 5 days — fixed in the code.)
# Comma-separated allowed origins for CORS (leave empty when the API serves the frontend itself)
CORS_ORIGINS=

# ---- Emails (Resend: https://resend.com) ----
# Team logins & passwords, owner welcome, forgot-password links, password-changed notices,
# new online orders, receipts, debt reminders (customers with an email) and trial-ending notices.
# Without RESEND_API_KEY nothing is sent: emails are only logged (email_log table) and the app keeps working.
RESEND_API_KEY=
# Sender. Must be on a domain you verified in Resend (the default only reaches your own Resend account email).
EMAIL_FROM=Kargo <onboarding@resend.dev>
# Optional: where replies go (e.g. your support inbox)
EMAIL_REPLY_TO=
# Public address of the app, used for links in emails (e.g. https://app.example.com). Falls back to the request's host.
APP_URL=

# ---- Help & Support / Billing page ----
# Where "Send us a message" goes (needs RESEND_API_KEY), and the WhatsApp number shown to customers (international, e.g. 2376XXXXXXXX)
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# Plans and prices are managed in the super admin dashboard (Plans).

# ---- Super admin dashboard (platform owners only) ----
# Required: a long random secret (encrypts the authenticator secrets). e.g. openssl rand -base64 48
ADMIN_SECRET=
# The admin runs ONLY on this host, e.g. admin.yourkargo.com (point the DNS at this server). In production
# (NODE_ENV=production) the admin is switched off until this is set. The business app is never served here.
ADMIN_HOST=
# Optional extra layers:
#   Cloudflare Access in front of ADMIN_HOST — set both (Zero Trust → Access → Applications → your app):
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
#   Only these IPs / ranges may reach the admin, comma-separated (e.g. 102.244.0.0/16,41.202.219.10)
ADMIN_IP_ALLOWLIST=
# TODO(2FA): two-step sign-in for admins (authenticator app + recovery codes) is OFF for now — set to true to require it
ADMIN_REQUIRE_2FA=false
# Where security alerts (lockouts) and "a business says it paid" notices go, besides the admins themselves
ADMIN_ALERT_EMAIL=
# The Super Admin is created from the server console (once):
#   node scripts/admin.js create --email you@company.com --name "Your Name"   (the one Super Admin; others are added in the dashboard)

# Automatic debt reminders: console | whatsapp | twilio | http
REMINDER_PROVIDER=console
# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en
# Twilio (SMS, or WhatsApp with TWILIO_FROM=whatsapp:+1...)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Generic SMS gateway (POST JSON {to, message, sender})
SMS_HTTP_URL=
SMS_HTTP_AUTH=
SMS_SENDER=
# Optional: override default Cameroon MoMo withdrawal fee tables (JSON object).
# Also editable per business in Settings. Example:
# MOMO_FEE_TABLES={"MTN MoMo":[{"min":100,"max":4166,"type":"fixed","fee":54},{"min":4167,"max":333332,"type":"pct","pct":1,"taxPct":0.2,"taxFixed":4},{"min":333333,"max":500000,"type":"fixed","fee":4004}],"Orange Money":[{"min":100,"max":4166,"type":"fixed","fee":54},{"min":4167,"max":333332,"type":"pct","pct":1,"taxPct":0.2,"taxFixed":4},{"min":333333,"max":500000,"type":"fixed","fee":4004}]}
# MOMO_FEE_TABLES=

# ---- Database / hosting ----
# PGSSL=true for hosted Postgres (Neon, Supabase, Railway…)
# PGSSL=true
# Max DB connections per server instance (default 10; 3 on Vercel). On Vercel use a POOLED DATABASE_URL.
# PG_POOL_MAX=
# Live updates: how often each open screen checks for changes (ms), and how long one stream stays open
# (seconds; default 50 on Vercel, unlimited elsewhere — the browser reconnects automatically).
# STREAM_POLL_MS=3000
# STREAM_SECONDS=

# ---- Vercel only ----
# Protects /api/cron/reminders (Vercel Cron sends it automatically). Any long random string.
# CRON_SECRET=this-is-a-secret-key
# Production deploys run database migrations during the build; set false to run `npm run migrate` yourself.
# MIGRATE_ON_BUILD=true

# ---- Mobile money payments (Fapshi: https://fapshi.com, docs https://docs.fapshi.com/en) ----
# Businesses pay their invoice with MTN MoMo or Orange Money; the plan starts by itself once it is paid.
# Without FAPSHI_API_USER / FAPSHI_API_KEY the Billing page only shows the manual ways to pay ("I have paid").
# Get both from the Fapshi dashboard → your service (sandbox and live have different keys).
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Sandbox (test money) unless set to false.
FAPSHI_SANDBOX=true
# false (default): the payer goes to Fapshi's payment page and comes back to Billing.
# true: the payer types their number in Kargo and approves a prompt on their phone (Fapshi "Direct Pay" —
#       it must be activated on your live account by Fapshi first).
FAPSHI_DIRECT_PAY=false
# Webhook: in the Fapshi dashboard set the service's webhook URL to  https://<your app>/api/fapshi/webhook
# and a webhook secret; put the same secret here. Every payment is re-checked with Fapshi before anything changes.
FAPSHI_WEBHOOK_SECRET=
# Optional: override the API address (defaults to the sandbox or live Fapshi API).
# FAPSHI_BASE_URL=
