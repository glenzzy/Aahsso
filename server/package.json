{
  "name": "kargo-server",
  "version": "1.0.0",
  "description": "Kargo \u2014 multi-tenant SaaS for importers/resellers: purchases, containers, landed cost, stock, POS, receivables, reports",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "import-backup": "node scripts/import-backup.js",
    "test": "node scripts/sync-public.js --check && node --test test/compute.test.js test/staff.test.js test/platform.test.js test/fapshi.test.js",
    "test:api": "node --test test/api.test.js",
    "test:email": "node --test test/email.test.js",
    "test:admin": "node --test test/admin-api.test.js test/features-api.test.js",
    "admin": "node scripts/admin.js",
    "seed-demo": "node scripts/seed-demo.js",
    "sync-public": "node scripts/sync-public.js",
    "deploy:vercel": "node scripts/sync-public.js && vercel deploy --prod",
    "test:fapshi": "node --test test/fapshi-api.test.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  }
}
